{
  "name": "neander-nextjs-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node init && next dev --hostname 127.0.0.1",
    "build": "node init && next build && node .neander/prepare-standalone.mjs",
    "start": "node init && node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local .neander/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@next/env": "16.3.4",
    "better-auth": "1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.23.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.3",
    "drizzle-kit": "0.31.10",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
