{
  "name": "neander-nextjs-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "radix-ui": "1.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "lucide-react": "1.23.0",
    "@fontsource/inter": "5.3.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.2",
    "@tailwindcss/postcss": "4.3.2",
    "postcss": "8.5.6",
    "tw-animate-css": "1.4.0"
  }
}
